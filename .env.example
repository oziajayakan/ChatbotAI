# ==============================================================================
# NOVA CHATBOT AI - ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================

# 1. GOOGLE GEMINI API (Wajib)
# Dapatkan API Key gratis di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model utama yang digunakan (default: gemini-3.8-flash)
# Otomatis failover ke: gemini-3.7-flash -> gemini-3.5-flash -> gemini-flash-latest jika terjadi rate limit / load spike.
GEMINI_MODEL=gemini-3.8-flash

# 2. CLOUD DATABASE (Turso / LibSQL SQLite Cloud) - Sangat Direkomendasikan untuk Vercel
# Daftar gratis di: https://turso.tech (Free Tier 9 GB Storage & 1 Miliar Reads/bulan)
# Biarkan kosong jika ingin menggunakan SQLite lokal (/tmp/nova_chatbot.db)
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your_turso_jwt_auth_token_here

# 3. LOKAL DATABASE PATH (Opsional)
# SQLITE_DB_PATH=.tmp/nova_chatbot.db
